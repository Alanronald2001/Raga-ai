{
  "compilerOptions": {
    "noEmit": true,
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@raga/shared-types": ["../../packages/shared-types/src"],
      "@raga/shared-ui": ["../../packages/shared-ui/src"],
      "@raga/mock-api": ["../../packages/mock-api/src"]
    },
    "types": ["vite/client"]
  },
  "include": ["src"]
}
